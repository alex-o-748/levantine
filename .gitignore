# The raw Lingua Libre recordings: large, redistributable from upstream, and
# only ever an input to tools/. Never committed — see corpus/README.md.
# fetch-commons-audio.py downloads into corpus/commons/.
corpus/*
!corpus/README.md

# Generated review pages — rebuild with tools/make_review.py
build/

__pycache__/
*.pyc

# A virtualenv for the tools/ scripts. Homebrew and system Pythons refuse
# `pip install` (PEP 668), so a venv in the checkout is the normal way to get
# huggingface_hub and the `hf` command; it must never be committed.
.venv/
venv/
